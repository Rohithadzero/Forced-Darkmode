# ---- Dependencies (re-created by `npm install`) ----
node_modules/

# ---- Build output (re-created by `npm run build`) ----
dist/
.vite/
*.tsbuildinfo

# ---- Packaged extension files ----
# .pem is the PRIVATE KEY Chrome makes when you "Pack extension". Never upload it.
*.pem
*.crx
*.zip

# ---- Test output ----
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Secrets / local config ----
.env
.env.*
!.env.example

# ---- Editor and OS junk ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Temporary files ----
tmp/
temp/
*.tmp

# ---- Internal planning notes / AI tool files (not part of the project) ----
docs/superpowers/
.claude/
CLAUDE.md
.superpowers/

# ---- Caches and local output ----
.cache/
.eslintcache
.npm/
screenshots/
*.local
